<script>
async function loadLevels() {
    try {
        // Fetch levels from backend API on port 3000
        const response = await fetch("http://localhost:3000/levels");
        const levels = await response.json();
        
        // Get the container element from HTML
        const container = document.getElementById("levels-container");
        
        // Clear the "Loading..." message
        container.innerHTML = "";
        
        // Loop through each level and create a card
        levels.forEach(level => {
            const levelCard = document.createElement("div");
            levelCard.className = "card";  // Use existing CSS class
            
            levelCard.innerHTML = `
                <h3> ${level.title}</h3>
                <button onclick="loadLessons(${level.id})">View Lessons</button>
            `;
            
            container.appendChild(levelCard);
        });
        
    } catch (error) {
        console.log("Error loading levels:", error);
        const container = document.getElementById("levels-container");
        container.innerHTML = "<p>Failed to load levels. Please try again later.</p>";
    }
}


// 🟢 الصق هذا الكود الجديد في نفس مكان الكود القديم الذي حذفته:

async function loadLessons(levelId) {
    // Fetch lessons for this level from backend API
    const response = await fetch(`http://localhost:3000/levels/${levelId}/lessons`);
    const lessons = await response.json();
    
    // Create a container to display lessons on the page
    const lessonsContainer = document.createElement("div");
    lessonsContainer.className = "section";
    lessonsContainer.innerHTML = `<h3>📖 Lessons for Level ${levelId}</h3>`;
    
    // Show message if no lessons found
    if (lessons.length === 0) {
        lessonsContainer.innerHTML += "<p>No lessons available yet.</p>";
    } else {
        // Loop through each lesson and create a card
        lessons.forEach(lesson => {
            const lessonCard = document.createElement("div");
            lessonCard.className = "card";
            lessonCard.innerHTML = `
                <h4>${lesson.title}</h4>
                ${lesson.video_url ? `<a href="${lesson.video_url}" target="_blank"> Watch</a><br>` : ''}
                ${lesson.pdf_url ? `<a href="${lesson.pdf_url}" target="_blank">📄 PDF</a>` : ''}
            `;
            lessonsContainer.appendChild(lessonCard);
        });
    }
    
    // Insert the lessons section after the levels container
    const levelsSection = document.getElementById("dynamic-levels");
    levelsSection.parentNode.insertBefore(lessonsContainer, levelsSection.nextSibling);
    
} catch (error) {
    // Handle errors gracefully
    console.log("Error loading lessons:", error);
    alert("Failed to load lessons. Please try again.");
}

</script>
